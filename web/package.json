{
  "name": "blockbound-dice-districts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm test && tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "test:rules": "node --test tests/rollRules.test.mjs",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=DEP0205 --test tests/rollRules.test.mjs tests/gameSave.test.mjs tests/rewards.test.mjs tests/quests.test.mjs tests/rotationEngine.test.mjs tests/questDispatcher.test.mjs tests/pwa.test.mjs tests/hotkeys.test.mjs tests/store.test.mjs",
    "test:store": "node --disable-warning=DEP0205 --test tests/store.test.mjs",
    "test:saves": "node --test tests/gameSave.test.mjs",
    "clean:appledouble": "bash ../scripts/clean-appledouble.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@react-three/drei": "^9.105.0",
    "@react-three/fiber": "^8.16.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
